# Copy to .env and add the provider key(s) you intend to use. Never commit .env.
#
#     cp .env.example .env
#     # put your key below
#     uv run op doctor        # tells you what is configured and what is reachable
#
# Everything beyond the provider credentials is optional. Every other setting
# here has a working default, so a line you never uncomment already works.
#
# Every commented setting is tagged:
#
#     ← default   the value shown IS what the code uses. Uncomment only to change it.
#     ← example   there is no default; the line shows the shape of a real value.


# ══════════════════════════════════════════════════════════════════════════
#  MODEL PROVIDERS — the only credentials needed for generation
# ══════════════════════════════════════════════════════════════════════════

# GPT transport. `auto` sends GPT calls directly to OpenAI when OPENAI_API_KEY
# is set and uses OpenRouter otherwise. `openai` requires OPENAI_API_KEY;
# `openrouter` always uses the gateway. Claude and Gemini continue to use
# OpenRouter in every mode.
# LLM_TRANSPORT=auto          # auto | openai | openrouter                  ← default

# Native GPT via the OpenAI Responses API. Leave blank if GPT should use
# OpenRouter. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# One OpenRouter key covers Claude, GPT and Gemini. It remains required for any
# route that selects Claude or Gemini. https://openrouter.ai/keys
OPENROUTER_API_KEY=


# ══════════════════════════════════════════════════════════════════════════
#  SOURCES — where evidence comes from
# ══════════════════════════════════════════════════════════════════════════
#
#  Four work RIGHT NOW with nothing configured:
#
#     hacker-news      Algolia search
#     stack-exchange   keyless, 300 requests/day
#     app-reviews      Apple's official review feed
#     github-issues    works unauthenticated, just rate-limited
#
#  You can run the whole pipeline on those alone. Everything in this section
#  adds more. `op doctor` lists which are live.

# --- Add a key, unlock a source -------------------------------------------

# GitHub: works without this, but a token lifts the ~10 requests/minute limit.
# Any classic token, no scopes needed. https://github.com/settings/tokens
GITHUB_TOKEN=

# Reddit: REQUIRED for Reddit — it returns 403 to anonymous search. Create a
# "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Stack Exchange: keyless works (300 req/day). This raises it to 10,000/day and
# is not a secret by their design. https://stackapps.com/apps/oauth/register
# STACKEXCHANGE_KEY=

# Tavily: general web search with no infrastructure. Free tier is 1,000
# credits/month, roughly 10-30 full runs. https://tavily.com
# TAVILY_API_KEY=

# --- Point a source at your own material ----------------------------------

# Discourse forums to search. Most dev-tool and SaaS product forums run
# Discourse, and this is usually the highest-signal source you can add —
# people describe pain there in their own words.
# DISCOURSE_FORUMS=["https://community.openai.com","https://discuss.huggingface.co","https://forum.cursor.com"] ← example

# RSS feeds. No search endpoint, so these are fetched and filtered locally.
# Prefer forums and issue trackers over news: announcements are not complaints.
# RSS_FEEDS=["https://hnrss.org/newest?q=devtools"]                       ← example

# Local corpora — interview notes, exported threads, anything with no API.
# CORPUS_PATHS=["./notes"]                                                ← example

# Self-hosted SearXNG for general web search. Enable `formats: [json]` in its
# settings.yml. Unset, the web collector reports itself unavailable.
# SEARXNG_URL=http://localhost:8888                                       ← example

# Stack Exchange sites to search.        default: ["stackoverflow"]
# STACKEXCHANGE_SITES=["stackoverflow","serverfault","askubuntu"]         ← example

# App Store storefronts, ~500 recent reviews each.   default: ["us"]
# APP_STORE_COUNTRIES=["us","gb"]                                         ← example

# --- How much to collect ---------------------------------------------------

# Restrict to specific sources.       default: every one that is available
# COLLECTORS=["github-issues","hacker-news"]                              ← example

# Items each collector returns per query.            default: 25
# Raise it for breadth. Raise it too far and one model call has to select from
# more candidates than it can answer about — that shows up as a truncation
# error naming MAX_OUTPUT_TOKENS.
# COLLECTOR_LIMIT=25                                                      ← default

# How much of each fetched item the selection prompt sees.   default: 2000
# A GitHub thread runs to 20,000 characters, of which the first few hundred say
# what the problem actually is.
# COLLECT_PREVIEW_CHARS=2000                                              ← default

# Share of MAX_INPUT_TOKENS the candidate list may occupy.   default: 0.6
# COLLECT_CONTEXT_FRACTION=0.6                                            ← default


# ══════════════════════════════════════════════════════════════════════════
#  MODELS — which model runs which stage
# ══════════════════════════════════════════════════════════════════════════
#
#  Stages ask for a CAPABILITY; capabilities point at a model TIER; tiers
#  resolve to the newest matching slug via OpenRouter's Models API. Nothing
#  here names a specific model, which is why a better one can arrive without
#  touching any stage. See the current mapping with `op routes`.
#
#     capabilities : fast_extract · summarize · synthesis · deep_reasoning
#                    market_reasoning · second_opinion
#     tiers        : gemini-flash · gemini-pro · claude-sonnet · claude-opus · gpt

# THE line to change when a better model appears — it moves every stage using
# that capability at once. Extraction runs cheap, reasoning runs deep.
# LLM_CAPABILITIES={"fast_extract":"gemini-flash","summarize":"gemini-pro","synthesis":"claude-sonnet","deep_reasoning":"claude-opus","market_reasoning":"gpt","second_opinion":"gpt"} ← example

# Rarely needed: what a stage needs is a fact about the work, not about models.
# LLM_STAGE_CAPABILITIES={"analyze-market":"deep_reasoning"}              ← example

# Capability for any stage without one of its own.
# LLM_DEFAULT_CAPABILITY=synthesis                                        ← default

# Tiers the gateway falls back to, in order, if the primary is down.
# LLM_FALLBACK_TIERS=["claude-sonnet","gpt"]                              ← example

# Adapter used when nothing else decides.
# LLM_PROVIDER=claude                                                     ← default

# Pin one model for everything, bypassing the routing table entirely.
# LLM_MODEL=anthropic/claude-sonnet-5                                     ← example

# Per-stage temperature.  defaults: 0.0 extraction and adversarial search,
#                                   0.2 where a stage must genuinely generate
# LLM_TEMPERATURES={"discover-opportunities":0.3}                         ← example

# Retries after a failed call, on top of the gateway's own failover.
# LLM_RETRY_ATTEMPTS=2                                                    ← default

# How the gateway picks among providers serving one model.
# LLM_SORT=price          # price | throughput | latency                  ← example

# Resolve tiers against the live Models API.        default: true
# Off, the pinned fallback slugs are used and no network call is made.
# LLM_USE_CATALOGUE=true                                                  ← default

# Optional attribution headers sent to OpenRouter.
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=Opportunity Engine                                 ← default
# OPENROUTER_TIMEOUT_MS=120000                                            ← default

# Native OpenAI endpoint and request timeout.
# OPENAI_BASE_URL=https://api.openai.com/v1                               ← default
# OPENAI_TIMEOUT_MS=120000                                                ← default


# ══════════════════════════════════════════════════════════════════════════
#  BUDGETS — what one call is allowed to cost
# ══════════════════════════════════════════════════════════════════════════

# Ceiling on what may be sent in one call.
# MAX_INPUT_TOKENS=200000                                                 ← default

# Ceiling on generated tokens — a CEILING, not what each stage asks for.
# Stages carry their own defaults sized to what they emit, because gateways
# reserve credit against max_tokens before the call: asking for the largest
# stage's budget everywhere makes the cheapest stage as dear to attempt as the
# most expensive.
# MAX_OUTPUT_TOKENS=12000                                                 ← default

# Per-stage output cap. Raise collect-evidence here if a wide COLLECTOR_LIMIT
# makes its selection reply hit the cap.
# LLM_MAX_OUTPUT_TOKENS={"collect-evidence":12000}                        ← example

# Cache the static prompt prefix where the provider supports it. The system and
# skill prompts barely change between calls.   defaults: true, 5m
# LLM_CACHE_PROMPTS=true                                                  ← default
# LLM_CACHE_TTL=5m                                                        ← default


# ══════════════════════════════════════════════════════════════════════════
#  EVERYTHING ELSE — sensible as-is
# ══════════════════════════════════════════════════════════════════════════

# Memory: embeds kept evidence locally so the same complaint cross-posted to two
# sites is counted once, and `op recall` can search past runs. Costs no tokens
# and no network beyond a one-time ~30MB model download (numpy only, no torch).
# MEMORY_ENABLED=true                                                     ← default
# EMBEDDING_MODEL=minishlab/potion-base-8M                                ← default
# Similarity at which two candidates are one complaint.   default: 0.92
# Toward 1.0, only near-verbatim cross-posts drop; lower, paraphrases merge.
# DEDUP_THRESHOLD=0.92                                                    ← default

# Telemetry: one JSONL record per model call — routing, tokens, cost, latency.
# Read it with `op calls`. A relative path resolves inside the workspace.
# TELEMETRY_ENABLED=true                                                  ← default
# TELEMETRY_PATH=.telemetry/calls.jsonl                                   ← default

# Run ledger. Any SQLAlchemy URL; SQLite by default.
# DATABASE_URL=sqlite:///./workspace/engine.db                            ← default
# DATABASE_ECHO=false                                                     ← default

# Artifact store of record — one directory per pipeline stage.
# WORKSPACE_DIR=workspace                                                 ← default

# MODEL_CACHE_PATH=.cache/openrouter-models.json                          ← default
# LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR | CRITICAL     ← default
